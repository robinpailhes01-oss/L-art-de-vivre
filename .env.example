# ── Variables Vercel (dashboard Next.js) ─────────────────────────────
# Copier en .env.local pour le dev local. Ce fichier liste UNIQUEMENT les
# variables réellement lues par le code Next.js (rien de spéculatif).

# Supabase (Settings → API du projet)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Service Baileys (Railway)
BAILEYS_SERVICE_URL=            # https://<app>.up.railway.app
BAILEYS_SERVICE_SECRET=         # = header x-baileys-secret (openssl rand -hex 24)

# Relance manuelle depuis la fiche lead (appel agent-followups)
CRON_SECRET=                    # = header x-cron-secret (openssl rand -hex 24)
