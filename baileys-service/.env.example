# ── Variables Railway (service Baileys) ──────────────────────────────

SUPABASE_URL=                   # https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Secrets partagés
AGENT_SHARED_SECRET=            # = x-agent-secret vers agent-concierge
BAILEYS_SERVICE_SECRET=         # = x-baileys-secret exigé sur les endpoints

PORT=3001

# Simulation de frappe humaine avant chaque réponse
AGENT_REPLY_DELAY_MS=8000
AGENT_REPLY_PER_CHAR_MS=25
AGENT_REPLY_DELAY_MAX_MS=15000

# Fenêtre de debounce des messages entrants
WA_DEBOUNCE_MS=12000
